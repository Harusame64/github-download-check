<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitHubDownloadCheck.ViewModels"
        xmlns:models="using:GitHubDownloadCheck.Models"
        xmlns:views="using:GitHubDownloadCheck.Views"
        xmlns:h="using:GitHubDownloadCheck.Helpers"
        x:Class="GitHubDownloadCheck.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GitHub Download Check"
        Width="1180" Height="780"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}">

  <Window.Styles>
    <!-- サイドバーの項目: 選択中は淡いアクセント地＋左端のバー -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavHoverBrush}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem Border.navMarker">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected Border.navMarker">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock.navTitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="240,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="16,18,16,14" ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                  Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
            <TextBlock Text="↓" Foreground="White" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="Download Check" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Text="{h:Localize Sidebar_AppSubtitle}" Classes="muted"/>
          </StackPanel>
        </Grid>

        <!-- Settings Button -->
        <Button DockPanel.Dock="Bottom" Content="{h:Localize Sidebar_Settings}" Command="{Binding OpenSettingsCommand}"
                Classes="subtle"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Margin="8,4,8,12" Padding="12,9"/>

        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}" Margin="12,0"/>

        <TextBlock DockPanel.Dock="Top" Text="{h:Localize Sidebar_Repositories}" Classes="muted"
                   FontWeight="SemiBold" Margin="20,4,0,6"/>

        <TextBlock DockPanel.Dock="Top" Text="{h:Localize Sidebar_AddRepositoryHint}"
                   Classes="muted" TextWrapping="Wrap" Margin="20,8"
                   IsVisible="{Binding !Repositories.Count}"/>

        <!-- Repository List -->
        <ListBox Classes="nav" Margin="8,0"
                 ItemsSource="{Binding Repositories}"
                 SelectedItem="{Binding DashboardViewModel.SelectedRepository}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:RepositoryEntry">
              <Grid ColumnDefinitions="3,*">
                <Border Grid.Column="0" Classes="navMarker" CornerRadius="2" Margin="0,8"/>
                <StackPanel Grid.Column="1" Spacing="1" Margin="10,8,10,8">
                  <TextBlock Classes="navTitle" Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                  <TextBlock Text="{Binding FullName}" Classes="muted" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding DisplayName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>
    </Border>

    <!-- Main Content Area -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <!-- Top Bar -->
      <Border Grid.Row="0" Padding="24,14,20,14"
              BorderBrush="{DynamicResource DividerBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" MinHeight="40">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center"
                      IsVisible="{Binding !IsSettingsOpen}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding DashboardViewModel.SelectedRepository.Label}"
                         FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding DashboardViewModel.SelectedRepository.FullName}"
                         Classes="muted" VerticalAlignment="Center"
                         IsVisible="{Binding DashboardViewModel.SelectedRepository.DisplayName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <TextBlock Text="{Binding DashboardViewModel.StatusText}" Classes="muted"
                       IsVisible="{Binding DashboardViewModel.StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
          <TextBlock Grid.Column="0" Text="{h:Localize TopBar_SettingsTitle}"
                     FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"
                     IsVisible="{Binding IsSettingsOpen}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Content="{h:Localize TopBar_Refresh}" Classes="accent" Padding="14,7"
                    Command="{Binding DashboardViewModel.FetchCommand}"
                    IsEnabled="{Binding !DashboardViewModel.IsLoading}"
                    IsVisible="{Binding !IsSettingsOpen}"/>
            <Button Content="{h:Localize TopBar_Close}" Padding="14,7" CornerRadius="6"
                    Command="{Binding CloseSettingsCommand}"
                    IsVisible="{Binding IsSettingsOpen}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- View Content -->
      <ContentControl Grid.Row="1" Content="{Binding CurrentView}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView/>
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView/>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

    </Grid>
  </Grid>
</Window>
